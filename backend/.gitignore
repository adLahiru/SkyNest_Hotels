# === SkyNest Hotels Backend - Node.js TypeScript Project ===

# Logs and debug files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Dependency directories
node_modules/
jspm_packages/

# PNPM specific files
.pnpm-debug.log*
.pnpm/

# TypeScript compilation output (as configured in tsconfig.json)
dist/
build/

# TypeScript incremental compilation cache
*.tsbuildinfo

# Source maps
*.map

# Coverage reports and testing
coverage/
*.lcov
.nyc_output/
junit.xml

# Environment variables - KEEP config/*.env.* files but ignore any local overrides
.env
.env.local
.env.*.local
config/.env
config/.env.development
config/.env.test
config/.env.production

# Database migration files that might be generated
# migrations/

# Database dumps and backups
# *.sql
*.dump
backup/
dumps/

# Database connection files (if any local DB files are created)
*.db
*.sqlite
*.sqlite3

# Cache directories
.cache/
.parcel-cache/
.eslintcache
.stylelintcache

# Optional npm/yarn cache directory
.npm/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Temporary files
temp/
tmp/
*.tmp
*.temp

# Documentation build output
docs/build/

# pm2 logs
pm2.log
pm2-error.log

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Serverless directories
.serverless/

# Nodemon restart file
.nodemonrestart

# Lock files - keep pnpm-lock.yaml but ignore others
npm-lock.json
yarn.lock

# TypeScript declaration files (if not needed in repo)
# *.d.ts

# Build artifacts
*.tsbuildinfo
# Backup files
*.bak
*.backup
