{
  "extends": [
    "react-app",
    "react-app/jest"
  ],
  "rules": {
    "no-unused-vars": [
      "warn",
      {
        "vars": "all",
        "args": "after-used",
        "ignoreRestSiblings": true,
        "argsIgnorePattern": "^_"
      }
    ],
    "no-console": "warn",
    "no-debugger": "warn",
    "no-unreachable": "error",
    "no-duplicate-imports": "error",
    "prefer-const": "warn",
    "no-var": "warn"
  }
}
